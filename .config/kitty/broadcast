#!/bin/sh

# Wrapper for the `broadcast` kitten that uses a window docked at the top of the
# current tab to broadcast from, and only broadcasts to visible windows in that
# tab. The input is hidden in the dock, as the typed text is visible in the
# target windows anyway.
#
# The list of broadcast targets is not updated when new windows (including
# overlays) are created, as it doesn't seem currently possible to react to such
# events. But the wrapper can be called again from another window of the tab to
# "refresh" it. Calling it from the broadcast dock ends the broadcast instead.
#
# INSTALLATION
#
# Requires kitty 0.50.0 or later, for docked windows.
#
# You need the following files in your kitty config directory:
# - broadcast (this file): The wrapper. Make this file executable.
# - broadcast_settheme.py: Allows you to change theme options when broadcasting.
# - theme-broadcast.conf: The theme to apply when broadcasting.
#
# In addition, you need to have `jq` installed on your system.
#
# LIMITATIONS
#
# The broadcast window can't contain messages such as the broadcast status or
# instructions. The initial message disappears as soon as you start typing
# something, leaving the window empty.
#
# CONFIGURATION
#
# Add a key mapping to your `kitty.conf`:
#
#    map f4 launch --type background --allow-remote-control ~/.config/kitty/broadcast @active-kitty-window-id
#
# You can then hit F4 on your keyboard in a window to open a broadcast dock at
# the top of its tab. Hit F4 again or Ctrl+Esc in the dock to end the broadcast.

set -e

# Height of the broadcast dock as a number of rows, or as a percentage of the
# tab with a `%` suffix.
#
# Hiding the input makes the kitten print a newline, "Input hidden, press
# Ctrl+Alt+Esc to unhide:" and another newline below its header, and each Enter
# prints a newline. So with fewer than 5 rows the header scrolls out of view,
# and with 1 row the dock is blank.
DOCK_SIZE=1

# As of kitty 0.36.3, `kitten @ ls` reports the self window inconsistently for
# scripts launched in the background, and the `--self` option and `state:self`
# match expression are also impacted. It can also fix itself after some time,
# making it difficult to pin down.
# Scripts can be launched in the background with `remote_control_script` and
# `launch --type background`.
#
# To work around this, use `launch --type background --allow-remote-control` and
# pass the special argument `@active-kitty-window-id` [1] (it is not resolved
# when used with `remote_control_script`).
#
# Note: it resolves to the non-overlay window of the active group, or to the
# broadcast dock when it has the focus.
#
# [1]: https://sw.kovidgoyal.net/kitty/launch/#special-arguments
SELF="${1:?Missing @active-kitty-window-id argument}"

# The tab containing the self window.
tab="$(
    kitten @ ls \
    | jq --argjson self "$SELF" '
        .[] | .tabs[] | select(any(.windows[]; .id == $self))
        '
)"
if [ -z "$tab" ]; then
    echo "broadcast: no tab contains window $SELF" >&2
    exit 1
fi

# The broadcasting windows in the tab, as a match string. Normally just the
# broadcast dock if there is one.
broadcasters="$(
    printf '%s' "$tab" \
    | jq -r '
        [ .windows[] | select(.user_vars.broadcast_to)
        | "id:\(.id)"
        ] | join(" or ")
        '
)"

# The visible windows in the tab, as a match string: the top window of every
# group, except for docks (the broadcast dock, but also status bars, file trees,
# etc.) and broadcasting windows. The self window is included, as the dock
# doesn't cover it.
#
# Note: the list of groups reported by `kitten @ ls` includes the docks, which
# are the groups with a `dock` key.
targets="$(
    printf '%s' "$tab" \
    | jq -r '
        [ .windows[] | select(.user_vars.broadcast_to) | .id ] as $broadcasters
        | [ .groups[] | select(.dock == null)
          | .windows[-1] | select(IN($broadcasters[]) | not)
          | "id:\(.)"
          ] | join(" or ")
        '
)"

# Starting the broadcast again when the tab already has a broadcast dock should
# not add a new dock next to the existing one, but instead replace it. The
# effect is that the broadcast continues, but the list of target windows is
# refreshed to include windows that were opened since the last broadcast launch.
#
# The old dock closes asynchronously, so it can briefly coexist with the new
# one. Docks are never targets so it doesn't matter here, and
# broadcast_settheme.py takes care of the theme.
#
# When called from a broadcasting window, just end the broadcast. Without the
# early exit, it would depend on whether the window is already gone when
# launching the new dock in "the tab containing $SELF".
if [ -n "$broadcasters" ]; then
    kitten @ send-key --match "$broadcasters" ctrl+esc
fi
if printf '%s' "$tab" | jq -e --argjson self "$SELF" '
    any(.windows[]; .id == $self and .user_vars.broadcast_to)
    ' >/dev/null; then
    exit 0
fi

# The broadcasting window created by the broadcast kitten gets always excluded
# automatically.
#
# Note: `targets` is empty if there is no matching window, but this is
# interpreted by kitty's matching routine to mean `all`, and the same happens
# with an invalid match expression such as 'none' (as opposed to a valid, non-
# empty match expression that matches nothing).
#
# The tab bar displays the title of the active window, so the window title is
# visible while the dock has the focus. It stands in for the kitten's header,
# which doesn't stay visible in the dock (see DOCK_SIZE).
dock="$(
    kitten @ launch --match "window_id:$SELF" \
        --type tab-dock --dock-edge top --dock-size "$DOCK_SIZE" \
        --window-title "Broadcast" \
        --allow-remote-control \
        --var broadcast_to="${targets:-none}" \
        --watcher ./broadcast_settheme.py \
        kitty +kitten broadcast --match "${targets:-id:0 and not id:0}"
)"

# Hide the input by pressing the kitten's --hide-input-toggle key for the user.
#
# kitty encodes the key according to the keyboard mode of the dock, so it must
# only be sent once the kitten has enabled kitty's keyboard protocol. Otherwise
# it gets the legacy encoding, which the kitten doesn't recognize as the toggle
# and would broadcast. The kitten enables it before drawing its header, so wait
# until the dock isn't empty anymore (in the scrollback, as the header scrolls
# out of view right away in a one-row dock).
i=0
until kitten @ get-text --match "id:$dock" --extent all 2>/dev/null \
    | grep -q '[^[:space:]]'; do
    i=$((i + 1))
    if [ "$i" -ge 100 ]; then
        echo "broadcast: the kitten in window $dock didn't start, not hiding the input" >&2
        exit 1
    fi
    sleep 0.02
done
kitten @ send-key --match "id:$dock" ctrl+alt+esc

# As soon as something is typed into the broadcast window, it scrolls down again
# and hides the message, even when inputs are hidden. But at least it opens
# showing something, making the window recognizable.
kitten @ scroll-window --match "id:$dock" start
